# Puerto interno del contenedor
PORT=3000

# Puerto expuesto en tu máquina (http://localhost:HOST_PORT)
HOST_PORT=8091

# Entorno de ejecución: development | production | test
NODE_ENV=production

# Nombre, saludo y versión mostrados por la API
APP_NAME=docker-cicd-demo
APP_GREETING=Hola desde Docker
# En Azure lo sobrescribe el pipeline con el tag de la imagen (sha-<commit>)
APP_VERSION=dev

# Secreto obligatorio (cámbialo en cada entorno)
API_KEY=cambia-esta-clave-por-una-segura

# Nivel de log: debug | info | warn | error
LOG_LEVEL=info
